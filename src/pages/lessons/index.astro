---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';
import { courseConfig } from '../../config/course';

const entries = await getEntriesByKind('lesson');
---

<ListingLayout
  title="درس‌ها"
  description={`درس‌های ${courseConfig.title} به‌ترتیب وابستگی. هر درس را بخوانید، مثالش را حل کنید و با تمرین بسنجید.`}
  entries={entries}
/>