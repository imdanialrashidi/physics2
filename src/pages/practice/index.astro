---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';
import { courseConfig } from '../../config/course';

const entries = await getEntriesByKind('question');
---

<ListingLayout
  title="تمرین"
  description={`تمرین‌های ${courseConfig.title} برای سنجش فهم. پاسخ در مرورگر خودتان ذخیره می‌شود؛ هرچند بار بخواهید تلاش کنید.`}
  entries={entries}
/>